# Valores LOCAIS e descartáveis para o docker-compose (NÃO é produção).
# Servem só para rodar a imagem de produção na máquina, igual ao servidor,
# antes de publicar. Em produção, as variáveis vêm do painel do host (Dokploy).

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=dev-local-docker-apenas-para-testar-nao-use-em-producao
DEBUG=False
TIME_ZONE=America/Bahia

# App acessível em http://localhost:8000 (e no celular pela rede local).
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Local roda sobre HTTP: desliga as travas de HTTPS (em produção ficam LIGADAS).
SECURE_SSL_REDIRECT=False
SECURE_COOKIES=False
SECURE_HSTS_SECONDS=0

# Banco: Postgres do próprio compose (serviço "db"), sempre ligado — sem cold start.
DATABASE_URL=postgres://bahiacar:bahiacar@db:5432/bahiacar

# Storage: s3mock do próprio compose (S3-compatível), no lugar do R2.
AWS_STORAGE_BUCKET_NAME=bahiacar-midia
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_ENDPOINT_URL=http://s3:9090
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path

# Login do dono criado no start (idempotente).
ADMIN_URL=painel-interno/
RESP_USUARIO=dono
RESP_SENHA=troca-essa-senha-123
RESP_NOME=Dono da Loja
RESP_EMPRESA=Bahia Car
