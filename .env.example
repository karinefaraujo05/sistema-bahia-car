# Copie este arquivo para .env e preencha os valores.
# O .env NUNCA é versionado (está no .gitignore). Aqui ficam só os nomes.

# Chave secreta do Django. Gere uma com:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-chave

# True só em desenvolvimento. Em produção deixe False (ou não defina).
DEBUG=True

# Hosts liberados. Em produção, o domínio real.
# Para testar no celular na rede local, acrescente o IP da máquina (ex.: 192.168.0.10).
ALLOWED_HOSTS=localhost,127.0.0.1

# Fuso horário.
TIME_ZONE=America/Bahia

# Banco de dados (PostgreSQL).
# Em desenvolvimento usamos um Postgres gerenciado na nuvem (Neon). Copie a connection
# string do painel do Neon (começa com postgresql:// e termina com ?sslmode=require).
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Alternativa local com Docker (ver docker-compose.yml): porta 5433 para não conflitar
# com um Postgres local na 5432.
# DATABASE_URL=postgres://bahiacar:bahiacar@localhost:5433/bahiacar

# Endereço do painel do Django admin (propositalmente não óbvio). Termine com /.
ADMIN_URL=painel-interno/

# Limite de upload de documentos, em MB.
TAMANHO_MAXIMO_UPLOAD_MB=20

# Consulta de placa externa (API paga, OPCIONAL). Deixe "none" para desligar.
# Provedores: none | apibrasil | simplesapi | credify.
# Comece com apibrasil ou simplesapi (self-service, ~R$ 0,10/consulta, crédito grátis
# pra testar). Credify exige CNPJ e contato comercial. Reconfirme preços na contratação.
CONSULTA_PLACA_PROVIDER=none
CONSULTA_PLACA_TOKEN=
# Opcional: só preencha se precisar apontar para outra URL do provedor.
CONSULTA_PLACA_URL=

# Ler documento por FOTO com IA (OPCIONAL). Deixe "none" para desligar.
# Com "claude", o sistema lê a foto do documento (CRLV/CNH) e preenche os campos.
# Precisa de uma chave da Anthropic (console.anthropic.com), paga por uso, sem mínimo.
OCR_IA_PROVIDER=none
ANTHROPIC_API_KEY=
# Modelo: claude-opus-4-8 (mais preciso) ou claude-haiku-4-5 (~5x mais barato).
OCR_IA_MODELO=claude-opus-4-8

# Somente produção: origens confiáveis para CSRF (com https://).
# CSRF_TRUSTED_ORIGINS=https://seudominio.com.br
